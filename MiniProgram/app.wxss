page {
  min-height: 100%;
  color: #f2e4c4;
  background:
    linear-gradient(180deg, rgba(27, 70, 59, 0.96) 0%, rgba(16, 24, 22, 0.98) 46%, #101816 100%);
  font-family: "PingFang SC", "Microsoft YaHei UI", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

button,
input {
  font: inherit;
}

button::after {
  border: 0;
}

.safe-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx calc(156rpx + env(safe-area-inset-bottom));
}

.surface {
  box-sizing: border-box;
  color: #f2e4c4;
  background: rgba(16, 31, 27, 0.94);
  border: 2rpx solid rgba(213, 169, 78, 0.34);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.22);
}

.eyebrow {
  color: #62c6d4;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.muted {
  color: #b7c3b8;
}

.warm {
  color: #f2e4c4;
}

.gold {
  color: #d5a94e;
}

.primary-button,
.secondary-button,
.quiet-button {
  box-sizing: border-box;
  min-height: 96rpx;
  margin: 0;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  font-weight: 800;
  line-height: 1.25;
  transition: opacity 180ms ease, background-color 180ms ease, border-color 180ms ease;
}

.primary-button {
  color: #101816;
  background: #d5a94e;
  border: 2rpx solid #f2e4c4;
}

.secondary-button {
  color: #f2e4c4;
  background: #173b32;
  border: 2rpx solid #62c6d4;
}

.quiet-button {
  color: #d8dfd6;
  background: rgba(16, 24, 22, 0.72);
  border: 2rpx solid rgba(242, 228, 196, 0.2);
}

.button-pressed {
  opacity: 0.72;
}

.status-chip,
.tag-chip {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.status-chip {
  color: #101816;
  background: #62c6d4;
  border: 2rpx solid #c8f6f5;
}

.tag-chip {
  color: #f2e4c4;
  background: #4a2e22;
  border: 2rpx solid rgba(213, 169, 78, 0.45);
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
}

.card-rail {
  width: 100%;
  white-space: nowrap;
}

.card-rail-inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 8rpx 2rpx 12rpx;
}

.mini-card {
  position: relative;
  display: inline-flex;
  box-sizing: border-box;
  flex: 0 0 132rpx;
  width: 132rpx;
  min-width: 132rpx;
  flex-direction: column;
  overflow: hidden;
  vertical-align: top;
  color: #f2e4c4;
  background: #101816;
  border: 3rpx solid #6e5130;
  border-radius: 15rpx;
}

.mini-card-golden {
  border-color: #e7c45d;
  box-shadow: 0 0 0 2rpx rgba(242, 228, 196, 0.28);
}

.mini-card-art,
.tutorial-card-art,
.missing-card-art {
  display: flex;
  width: 100%;
  height: 174rpx;
  align-items: center;
  justify-content: center;
  background: #173b32;
}

.mini-card-art {
  display: block;
}

.tutorial-card-art {
  color: #101816;
  background: radial-gradient(circle at 50% 38%, #b9e8e7 0%, #62c6d4 42%, #173b32 100%);
  font-family: STKaiti, KaiTi, serif;
  font-size: 66rpx;
  font-weight: 800;
}

.missing-card-art {
  color: #f2e4c4;
  font-size: 28rpx;
}

.mini-card-name {
  display: block;
  min-height: 66rpx;
  padding: 8rpx 8rpx 10rpx;
  overflow: hidden;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
  white-space: normal;
}

.mini-card-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  padding: 2rpx 7rpx;
  color: #101816;
  background: #d5a94e;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
}

.empty-state,
.error-state {
  padding: 48rpx 32rpx;
  text-align: center;
}

.error-state {
  color: #ffd0c8;
  border-color: rgba(221, 91, 70, 0.68);
}

@media (min-width: 768px) {
  .safe-page {
    width: 720px;
    margin: 0 auto;
    padding-right: 48rpx;
    padding-left: 48rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .primary-button,
  .secondary-button,
  .quiet-button {
    transition: none;
  }
}
